# Copy this file to .env.local for local testing with `vercel dev`.
# NEVER commit an actual .env.local file to git — check that .gitignore
# includes it before you push anything.
#
# In production, you don't use this file at all — you set these same
# variables in the Vercel dashboard: your project → Settings →
# Environment Variables. That's true for Preview and Production
# environments both; Vercel keeps them separate on purpose.

# Your Paystack SECRET key. Starts with sk_test_ while testing,
# sk_live_ once you're ready for real payments. Find it at
# dashboard.paystack.com → Settings → API Keys & Webhooks.
# This key grants full access to your Paystack account — treat it the
# way you'd treat online banking credentials, not a normal config value.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
